rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function roleDocument() {
      return get(/databases/$(database)/documents/user_roles/$(request.auth.uid));
    }

    function hasRoleDocument() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/user_roles/$(request.auth.uid));
    }

    function currentRole() {
      return roleDocument().data.role;
    }

    function currentFamilyIds() {
      return roleDocument().data.familyIds;
    }

    function isActiveUser() {
      return hasRoleDocument() &&
        roleDocument().data.active == true &&
        roleDocument().data.role in ['member', 'editor', 'admin', 'superAdmin'] &&
        roleDocument().data.familyIds is list;
    }

    function isSuperAdmin() {
      return isActiveUser() && currentRole() == 'superAdmin';
    }

    function belongsToFamily(familyId) {
      return isActiveUser() && currentFamilyIds().hasAny([familyId]);
    }

    function isFamilyMember(familyId) {
      return belongsToFamily(familyId) &&
        currentRole() in ['member', 'editor', 'admin'];
    }

    function isFamilyEditor(familyId) {
      return belongsToFamily(familyId) &&
        currentRole() in ['editor', 'admin'];
    }

    function isFamilyAdmin(familyId) {
      return belongsToFamily(familyId) && currentRole() == 'admin';
    }

    function isOwner(ownerUid) {
      return isSignedIn() && ownerUid != null && ownerUid == request.auth.uid;
    }

    function isSameUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function canAdministerFamily(familyId) {
      return isSuperAdmin() || isFamilyAdmin(familyId);
    }

    function isValidString(value, maximumLength) {
      return value is string && value.size() <= maximumLength;
    }

    function isNullableString(value, maximumLength) {
      return value == null || isValidString(value, maximumLength);
    }

    function isValidStringList(value, maximumItems) {
      return value is list && value.size() <= maximumItems;
    }

    function isValidTimestamp(value) {
      return value is timestamp;
    }

    function familyKeysAreValid() {
      return request.resource.data.keys().hasOnly([
        'id', 'name', 'active', 'schemaVersion', 'version', 'createdAt',
        'updatedAt', 'createdBy', 'updatedBy', 'description', 'isPublic'
      ]) &&
        request.resource.data.keys().hasAll([
          'id', 'name', 'active', 'schemaVersion', 'updatedAt'
        ]);
    }

    function validFamilyDocument(familyId) {
      return familyKeysAreValid() &&
        request.resource.data.id == familyId &&
        isValidString(request.resource.data.name, 200) &&
        request.resource.data.active is bool &&
        request.resource.data.schemaVersion is int &&
        request.resource.data.schemaVersion >= 1 &&
        request.resource.data.updatedAt == request.time;
    }

    function publicMemberKeysAreValid() {
      return request.resource.data.keys().hasOnly([
        'id', 'familyId', 'firstName', 'lastName', 'gender', 'fatherId',
        'motherId', 'spouseIds', 'childrenIds', 'parents', 'spouses',
        'children', 'birthYear', 'birthCity', 'isDeceased', 'photoUrl',
        'familyCode', 'generation', 'displayOrder', 'isPatriarch', 'publicBiography',
        'createdAt', 'updatedAt', 'schemaVersion', 'deletedAt', 'isDeleted',
        'deletedBy', 'visibility'
      ]) &&
        request.resource.data.keys().hasAll([
          'id', 'familyId', 'firstName', 'lastName', 'gender', 'fatherId',
          'motherId', 'spouseIds', 'childrenIds', 'parents', 'spouses',
          'children', 'birthCity', 'isDeceased', 'generation', 'updatedAt',
          'schemaVersion', 'deletedAt'
        ]);
    }

    function validPublicMember(familyId, memberId) {
      return publicMemberKeysAreValid() &&
        request.resource.data.id == memberId &&
        request.resource.data.familyId == familyId &&
        request.resource.data.schemaVersion == 2 &&
        isValidString(request.resource.data.firstName, 120) &&
        isValidString(request.resource.data.lastName, 120) &&
        isValidString(request.resource.data.gender, 30) &&
        isValidString(request.resource.data.fatherId, 128) &&
        isValidString(request.resource.data.motherId, 128) &&
        isValidStringList(request.resource.data.spouseIds, 50) &&
        isValidStringList(request.resource.data.childrenIds, 200) &&
        isValidStringList(request.resource.data.parents, 10) &&
        isValidStringList(request.resource.data.spouses, 50) &&
        isValidStringList(request.resource.data.children, 200) &&
        isValidString(request.resource.data.birthCity, 160) &&
        (!('familyCode' in request.resource.data) ||
          isValidString(request.resource.data.familyCode, 128)) &&
        request.resource.data.isDeceased is bool &&
        request.resource.data.generation is int &&
        request.resource.data.generation >= 0 &&
        isValidString(request.resource.data.deletedAt, 64) &&
        (!('isDeleted' in request.resource.data) ||
          request.resource.data.isDeleted is bool) &&
        (!('deletedBy' in request.resource.data) ||
          isValidString(request.resource.data.deletedBy, 128)) &&
        (!('visibility' in request.resource.data) ||
          request.resource.data.visibility in ['visible', 'hidden']) &&
        request.resource.data.updatedAt == request.time &&
        (!('birthYear' in request.resource.data) ||
          request.resource.data.birthYear is int) &&
        (!('photoUrl' in request.resource.data) ||
          isNullableString(request.resource.data.photoUrl, 2048)) &&
        (!('createdAt' in request.resource.data) ||
          isValidTimestamp(request.resource.data.createdAt));
    }

    function validPublicMemberUpdate(familyId, memberId) {
      return validPublicMember(familyId, memberId) &&
        (request.resource.data.familyId == resource.data.familyId ||
          (familyId == 'ayivon' &&
            resource.data.familyId == 'family-ayivon' &&
            request.resource.data.familyId == 'ayivon')) &&
        request.resource.data.id == resource.data.id &&
        (!('createdAt' in resource.data) ||
          request.resource.data.createdAt == resource.data.createdAt);
    }

    function privateMemberKeysAreValid() {
      return request.resource.data.keys().hasOnly([
        'memberId', 'familyId', 'ownerUid', 'fullBirthDate', 'birthLastName',
        'originalLastName', 'birthPlace', 'birthCountry', 'deathDate',
        'deathPlace', 'burialPlace', 'publicMapLocation', 'currentAddress',
        'currentCity', 'currentRegion', 'currentCountry', 'latitude',
        'longitude', 'importantPlaces', 'email', 'phone', 'whatsapp',
        'allowContact', 'emailVisibility', 'phoneVisibility',
        'whatsappVisibility', 'visibilitySettings', 'originFamilyId',
        'linkedTreeEnabled', 'familyCode', 'marriageType', 'history',
        'privateNotes', 'isTemporaryProfile', 'profileNeedsCompletion',
        'version', 'schemaVersion', 'createdAt', 'updatedAt', 'createdBy',
        'updatedBy', 'deletedAt', 'isDeleted', 'deletedBy', 'visibility'
      ]) &&
        request.resource.data.keys().hasAll([
          'memberId', 'familyId', 'schemaVersion', 'updatedAt'
        ]);
    }

    function validPrivateMember(familyId, memberId) {
      return privateMemberKeysAreValid() &&
        request.resource.data.memberId == memberId &&
        request.resource.data.familyId == familyId &&
        request.resource.data.schemaVersion == 2 &&
        request.resource.data.updatedAt == request.time &&
        (!('ownerUid' in request.resource.data) ||
          request.resource.data.ownerUid == null ||
          isValidString(request.resource.data.ownerUid, 128)) &&
        (!('fullBirthDate' in request.resource.data) ||
          isValidString(request.resource.data.fullBirthDate, 32)) &&
        (!('email' in request.resource.data) ||
          isValidString(request.resource.data.email, 320)) &&
        (!('phone' in request.resource.data) ||
          isValidString(request.resource.data.phone, 64)) &&
        (!('whatsapp' in request.resource.data) ||
          isValidString(request.resource.data.whatsapp, 64)) &&
        (!('privateNotes' in request.resource.data) ||
          isValidString(request.resource.data.privateNotes, 10000)) &&
        (!('deletedAt' in request.resource.data) ||
          isValidString(request.resource.data.deletedAt, 64)) &&
        (!('isDeleted' in request.resource.data) ||
          request.resource.data.isDeleted is bool) &&
        (!('deletedBy' in request.resource.data) ||
          isValidString(request.resource.data.deletedBy, 128)) &&
        (!('visibility' in request.resource.data) ||
          request.resource.data.visibility in ['visible', 'hidden']) &&
        (!('createdAt' in request.resource.data) ||
          isValidTimestamp(request.resource.data.createdAt));
    }

    function ownerUidIsImmutable() {
      return (!('ownerUid' in resource.data) &&
          !('ownerUid' in request.resource.data)) ||
        (('ownerUid' in resource.data) &&
          ('ownerUid' in request.resource.data) &&
          request.resource.data.ownerUid == resource.data.ownerUid);
    }

    function validPrivateMemberUpdate(familyId, memberId) {
      return validPrivateMember(familyId, memberId) &&
        (request.resource.data.familyId == resource.data.familyId ||
          (familyId == 'ayivon' &&
            resource.data.familyId == 'family-ayivon' &&
            request.resource.data.familyId == 'ayivon')) &&
        request.resource.data.memberId == resource.data.memberId &&
        ownerUidIsImmutable() &&
        (!('createdAt' in resource.data) ||
          request.resource.data.createdAt == resource.data.createdAt);
    }

    function ownerChangesOnlyPersonalFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'fullBirthDate', 'birthLastName', 'originalLastName', 'birthPlace',
        'birthCountry', 'deathDate', 'deathPlace', 'burialPlace',
        'publicMapLocation', 'currentAddress', 'currentCity', 'currentRegion',
        'currentCountry', 'latitude', 'longitude', 'importantPlaces', 'email',
        'phone', 'whatsapp', 'allowContact', 'emailVisibility',
        'phoneVisibility', 'whatsappVisibility', 'visibilitySettings',
        'history', 'privateNotes', 'updatedAt', 'version'
      ]);
    }

    function validTenantCreate() {
      return request.resource.data.familyId is string &&
        (isSuperAdmin() || isFamilyEditor(request.resource.data.familyId));
    }

    function validTenantUpdate() {
      return request.resource.data.familyId == resource.data.familyId &&
        (isSuperAdmin() || isFamilyEditor(resource.data.familyId));
    }

    function validAppErrorLogCreate() {
      return request.resource.data.keys().hasOnly([
        'familyId', 'environment', 'severity', 'feature', 'methodName',
        'sourceFile', 'sourceLine', 'sourceColumn', 'errorType', 'errorCode',
        'errorMessage', 'stackTrace', 'operation', 'entityType', 'entityId',
        'uid', 'role', 'route', 'appVersion', 'platform', 'createdAt',
        'resolved'
      ]) &&
        request.resource.data.keys().hasAll([
          'familyId', 'environment', 'severity', 'feature', 'methodName',
          'errorType', 'errorMessage', 'stackTrace', 'operation',
          'entityType', 'uid', 'role', 'createdAt', 'resolved'
        ]) &&
        request.resource.data.familyId is string &&
        belongsToFamily(request.resource.data.familyId) &&
        currentRole() in ['editor', 'admin', 'superAdmin'] &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.role == currentRole() &&
        request.resource.data.environment in ['development', 'staging', 'production'] &&
        request.resource.data.severity in ['warning', 'error', 'critical'] &&
        isValidString(request.resource.data.feature, 100) &&
        isValidString(request.resource.data.methodName, 180) &&
        isValidString(request.resource.data.errorType, 180) &&
        isValidString(request.resource.data.errorMessage, 1000) &&
        isValidString(request.resource.data.stackTrace, 8000) &&
        isValidString(request.resource.data.operation, 80) &&
        isValidString(request.resource.data.entityType, 80) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.resolved == false;
    }

    match /families/{familyId} {
      allow read: if resource.data.isPublic == true ||
        belongsToFamily(familyId) || isSuperAdmin();
      allow create: if canAdministerFamily(familyId) &&
        validFamilyDocument(familyId);
      allow update: if canAdministerFamily(familyId) &&
        validFamilyDocument(familyId) &&
        request.resource.data.id == resource.data.id &&
        (!('createdAt' in resource.data) ||
          request.resource.data.createdAt == resource.data.createdAt) &&
        (!('createdBy' in resource.data) ||
          request.resource.data.createdBy == resource.data.createdBy);
      allow delete: if isSuperAdmin();

      match /members_public/{memberId} {
        allow read: if true;
        allow create: if (isSuperAdmin() || isFamilyEditor(familyId)) &&
          validPublicMember(familyId, memberId) &&
          request.resource.data.deletedAt == '' &&
          (!('isDeleted' in request.resource.data) ||
            request.resource.data.isDeleted == false) &&
          (!('deletedBy' in request.resource.data) ||
            request.resource.data.deletedBy == '') &&
          (!('visibility' in request.resource.data) ||
            request.resource.data.visibility == 'visible');
        allow update: if validPublicMemberUpdate(familyId, memberId) &&
          (canAdministerFamily(familyId) ||
            (isFamilyEditor(familyId) &&
              resource.data.deletedAt == '' &&
              request.resource.data.deletedAt == '' &&
              (!('isDeleted' in request.resource.data) ||
                request.resource.data.isDeleted == false) &&
              (!('deletedBy' in request.resource.data) ||
                request.resource.data.deletedBy == '') &&
              (!('visibility' in request.resource.data) ||
                request.resource.data.visibility == 'visible')));
        allow delete: if false;
      }

      match /members_private/{memberId} {
        allow read: if isActiveUser() &&
          (isSuperAdmin() || isFamilyAdmin(familyId) ||
            (belongsToFamily(familyId) && isOwner(resource.data.ownerUid)));
        allow create: if (isSuperAdmin() || isFamilyEditor(familyId)) &&
          validPrivateMember(familyId, memberId) &&
          (!('deletedAt' in request.resource.data) ||
            request.resource.data.deletedAt == '') &&
          (!('isDeleted' in request.resource.data) ||
            request.resource.data.isDeleted == false) &&
          (!('deletedBy' in request.resource.data) ||
            request.resource.data.deletedBy == '') &&
          (!('visibility' in request.resource.data) ||
            request.resource.data.visibility == 'visible') &&
          (!('ownerUid' in request.resource.data) ||
            request.resource.data.ownerUid == null);
        allow update: if validPrivateMemberUpdate(familyId, memberId) &&
          (canAdministerFamily(familyId) ||
            (isFamilyEditor(familyId) &&
              (!('deletedAt' in resource.data) || resource.data.deletedAt == '') &&
              (!('deletedAt' in request.resource.data) ||
                request.resource.data.deletedAt == '') &&
              (!('isDeleted' in request.resource.data) ||
                request.resource.data.isDeleted == false) &&
              (!('deletedBy' in request.resource.data) ||
                request.resource.data.deletedBy == '') &&
              (!('visibility' in request.resource.data) ||
                request.resource.data.visibility == 'visible')) ||
            (belongsToFamily(familyId) &&
              isOwner(resource.data.ownerUid) &&
              ownerChangesOnlyPersonalFields()));
        allow delete: if false;
      }
    }

    match /members/{memberId} {
      allow read: if isSuperAdmin() ||
        (resource.data.familyId is string &&
          isFamilyAdmin(resource.data.familyId));
      allow create, update, delete: if false;
    }

    match /user_roles/{uid} {
      allow read: if isSameUser(uid) || isSuperAdmin() ||
        (isActiveUser() && currentRole() == 'admin' &&
          resource.data.familyIds is list &&
          resource.data.familyIds.hasAny(currentFamilyIds()));
      allow create, update, delete: if false;
    }

    // Transition: only the Admin SDK creates or mutates server operations.
    // Final member writes remain temporarily available below for legacy
    // emulator comparison; firestore.rules.target removes that compatibility.
    match /operation_queue/{operationId} {
      allow read: if isActiveUser() &&
        (resource.data.createdBy == request.auth.uid ||
          isSuperAdmin() ||
          (resource.data.familyId is string &&
            isFamilyAdmin(resource.data.familyId)));
      allow create, update, delete: if false;
    }

    match /operation_idempotency/{documentId} {
      allow read, write: if false;
    }

    match /operation_payloads/{documentId} {
      allow read, write: if false;
    }

    match /operation_resource_state/{documentId} {
      allow read, write: if false;
    }

    match /operation_dead_letters/{documentId} {
      allow read, write: if false;
    }

    match /system_health_checks/{documentId} {
      allow read, write: if false;
    }

    match /relationships/{relationshipId} {
      allow read: if resource.data.familyId == 'ayivon' ||
        belongsToFamily(resource.data.familyId) || isSuperAdmin();
      allow create: if validTenantCreate();
      allow update: if validTenantUpdate();
      allow delete: if isSuperAdmin() || isFamilyAdmin(resource.data.familyId);
    }

    match /family_tree_links/{linkId} {
      allow read: if resource.data.familyId == 'ayivon' ||
        belongsToFamily(resource.data.familyId) || isSuperAdmin();
      allow create: if validTenantCreate();
      allow update: if validTenantUpdate();
      allow delete: if isSuperAdmin() || isFamilyAdmin(resource.data.familyId);
    }

    match /notifications/{notificationId} {
      allow read: if belongsToFamily(resource.data.familyId) || isSuperAdmin();
      allow create: if validTenantCreate();
      allow update: if validTenantUpdate();
      allow delete: if isSuperAdmin() || isFamilyAdmin(resource.data.familyId);
    }

    match /announcements/{announcementId} {
      allow read: if belongsToFamily(resource.data.familyId) || isSuperAdmin();
      allow create: if validTenantCreate();
      allow update: if validTenantUpdate();
      allow delete: if isSuperAdmin() || isFamilyAdmin(resource.data.familyId);
    }

    match /activity_logs/{logId} {
      allow read: if isSuperAdmin() || isFamilyAdmin(resource.data.familyId);
      allow create: if validTenantCreate() &&
        request.resource.data.keys().hasAll(['familyId']);
      allow update: if false;
      allow delete: if isSuperAdmin() || isFamilyAdmin(resource.data.familyId);
    }

    match /admin_audit_logs/{logId} {
      allow read: if isSuperAdmin() || isFamilyAdmin(resource.data.familyId);
      allow create: if isSignedIn() &&
        canAdministerFamily(request.resource.data.familyId) &&
        request.resource.data.actorUid == request.auth.uid;
      allow update: if isSignedIn() &&
        canAdministerFamily(resource.data.familyId) &&
        request.resource.data.familyId == resource.data.familyId &&
        request.resource.data.actorUid == resource.data.actorUid;
      allow delete: if false;
    }

    match /sync_incidents/{incidentId} {
      allow read: if isSuperAdmin() || isFamilyAdmin(resource.data.familyId);
      allow create: if isActiveUser() &&
        belongsToFamily(request.resource.data.familyId) &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isSuperAdmin() || isFamilyAdmin(resource.data.familyId);
      allow delete: if isSuperAdmin();
    }

    match /app_error_logs/{logId} {
      allow create: if isActiveUser() && validAppErrorLogCreate();
      allow read: if isSuperAdmin() || isFamilyAdmin(resource.data.familyId);
      allow update: if (isSuperAdmin() || isFamilyAdmin(resource.data.familyId)) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'resolved', 'resolvedAt', 'resolvedBy'
        ]) &&
        request.resource.data.resolved is bool &&
        request.resource.data.resolvedBy == request.auth.uid &&
        request.resource.data.resolvedAt == request.time;
      allow delete: if false;
    }

    match /diagnostic_ping/{pingId} {
      allow read, delete: if isSameUser(pingId) && isFamilyAdmin('ayivon');
      allow create: if isSameUser(pingId) &&
        isFamilyAdmin(request.resource.data.familyId) &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.type == 'firestoreDiagnostic';
      allow update: if false;
    }

    match /settings/{settingId} {
      allow read: if resource.data.isPublic == true ||
        isSuperAdmin() ||
        (resource.data.familyId is string &&
          isFamilyAdmin(resource.data.familyId));
      allow create, update: if isSuperAdmin() ||
        (request.resource.data.familyId is string &&
          isFamilyAdmin(request.resource.data.familyId));
      allow delete: if isSuperAdmin();
    }

    match /access_code_configs/{document=**} {
      allow read, write: if false;
    }

    match /access_code_audit_logs/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
